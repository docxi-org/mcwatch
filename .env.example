# Копировать в .env. Секретов в репозитории нет (CLAUDE.md, «Правила кода»).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Файл SQLite. Каталог создаётся автоматически.
DATABASE_PATH=./data/mcwatch.db

# Единственный ключ LLM: OpenRouter (чат + эмбеддинги + Whisper).
# На шаге G1 не используется.
OPENROUTER_API_KEY=

# Подставляется в User-Agent при обращении к Metacritic.
CONTACT_EMAIL=you@example.com

# Часовой цикл внутри процесса: обход → резюме → эмбеддинги.
# false выключает его — например когда команды запускаются вручную.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MIN=60

# Каталог собранного фронта. Раздаётся, только если существует.
WEB_DIST=./web/dist

# Домен для Caddy в docker compose. Без него — localhost с
# самоподписанным сертификатом.
DOMAIN=localhost
